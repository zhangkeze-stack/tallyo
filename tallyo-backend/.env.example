# Privy App ID - from https://dashboard.privy.io
PRIVY_APP_ID=your-privy-app-id

# Privy verification key (public key) - from your Privy app settings.
# In a hosting dashboard, paste it on ONE line with \n between the lines.
PRIVY_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----\nyour-key-here\n-----END PUBLIC KEY-----"

# Comma-separated list of frontend URLs allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173

# --- Testnet auto-funding for new accounts (optional) ---
# A SEPARATE testnet-only wallet that holds a little MON. Never use a real wallet.
FAUCET_PRIVATE_KEY=
# FUND_MON=0.05
# FUND_MUSD=50

# --- Database (optional) ---
# Leave empty to use a local SQLite file. In production use a hosted Postgres URL.
DATABASE_URL=
